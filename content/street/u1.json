  {
    "id": "street.1.08",
    "review": "unreviewed",
    "en": "Woe to the conquered!",
    "la": "Vae victīs!",
    "fill": "victīs",
    "skills": [
      "street.exclaim"
    ],
    "tag": "vae + dative",
    "explain": "_vae_ (woe) takes the dative: _victīs_ is the dative plural of _victus_ (conquered). The Roman historian Livy puts these words in the mouth of the Gaul Brennus after he sacked Rome.",
    "distractors": [
      [
        "Vae victus!",
        "_victus_ is nominative. After _vae_, the people who suffer are in the dative: _victīs_."
      ],
      [
        "Vae victōs!",
        "_victōs_ is accusative. After _vae_: dative, _victīs_."
      ],
      [
        "Vae victī!",
        "_victī_ is nominative plural or genitive singular. After _vae_: dative, _victīs_."
      ]
    ]
  },
  {
    "id": "street.1.09",
